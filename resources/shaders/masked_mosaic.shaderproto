{
  "name": "masked_mosaic",
  "template": "res://resources/shaders/masked_mosaic.gdshader",
  "variants": [
    {
      "suffix": "_small",
      "replacements": {
        "tile_size : hint_range(2.0, 64.0) = 8.0": "tile_size : hint_range(2.0, 64.0) = 4.0",
        "mask_radius : hint_range(0.0, 1.0) = 0.3": "mask_radius : hint_range(0.0, 1.0) = 0.2"
      }
    },
    {
      "suffix": "_large",
      "replacements": {
        "tile_size : hint_range(2.0, 64.0) = 8.0": "tile_size : hint_range(2.0, 64.0) = 16.0",
        "mask_radius : hint_range(0.0, 1.0) = 0.3": "mask_radius : hint_range(0.0, 1.0) = 0.5"
      }
    }
  ]
}
