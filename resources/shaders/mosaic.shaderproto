{
  "name": "mosaic",
  "template": "res://resources/shaders/mosaic.gdshader",
  "variants": [
    {
      "suffix": "_fine",
      "replacements": {
        "tile_size : hint_range(2.0, 64.0) = 8.0": "tile_size : hint_range(2.0, 64.0) = 4.0"
      }
    },
    {
      "suffix": "_coarse",
      "replacements": {
        "tile_size : hint_range(2.0, 64.0) = 8.0": "tile_size : hint_range(2.0, 64.0) = 16.0"
      }
    },
    {
      "suffix": "_blocky",
      "replacements": {
        "tile_size : hint_range(2.0, 64.0) = 8.0": "tile_size : hint_range(2.0, 64.0) = 24.0",
        "amount : hint_range(0.0, 1.0) = 1.0": "amount : hint_range(0.0, 1.0) = 0.9"
      }
    }
  ]
}
