{
  "name": "motion_blur",
  "template": "res://resources/shaders/motion_blur.gdshader",
  "variants": [
    {
      "suffix": "_horizontal",
      "replacements": {
        "direction : hint_range(-1.0, 1.0) = vec2(1.0, 0.0)": "direction : hint_range(-1.0, 1.0) = vec2(1.0, 0.0)"
      }
    },
    {
      "suffix": "_vertical",
      "replacements": {
        "direction : hint_range(-1.0, 1.0) = vec2(1.0, 0.0)": "direction : hint_range(-1.0, 1.0) = vec2(0.0, 1.0)",
        "strength : hint_range(0.0, 10.0) = 3.0": "strength : hint_range(0.0, 10.0) = 4.0"
      }
    },
    {
      "suffix": "_diagonal",
      "replacements": {
        "direction : hint_range(-1.0, 1.0) = vec2(1.0, 0.0)": "direction : hint_range(-1.0, 1.0) = vec2(1.0, 1.0)",
        "strength : hint_range(0.0, 10.0) = 3.0": "strength : hint_range(0.0, 10.0) = 5.0"
      }
    }
  ]
}
