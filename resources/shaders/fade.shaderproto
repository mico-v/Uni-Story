{
  "name": "fade",
  "template": "res://resources/shaders/fade.gdshader",
  "variants": [
    {
      "suffix": "_white",
      "replacements": {
        "fade_color : source_color = vec4(0.0, 0.0, 0.0, 1.0)": "fade_color : source_color = vec4(1.0, 1.0, 1.0, 1.0)"
      }
    },
    {
      "suffix": "_red",
      "replacements": {
        "fade_color : source_color = vec4(0.0, 0.0, 0.0, 1.0)": "fade_color : source_color = vec4(1.0, 0.0, 0.0, 1.0)"
      }
    }
  ]
}
