[gd_resource type="Theme" load_steps=19 format=3 uid="uid://btheme_base_unistory"]

; Base structural theme for Uni-Story.
; Defines layout geometry ONLY:
;   content_margin, corner_radius, border_width, shadow_size, separation
; No colors, no font references — those belong in work-specific themes.
; Work themes set base_theme to this file and override colors/fonts.

